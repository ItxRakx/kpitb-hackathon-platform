# ========== Django Core ==========
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string-keep-it-secret
ALLOWED_HOSTS=127.0.0.1,localhost

# ========== PostgreSQL ==========
# If PostgreSQL is not installed locally, leave DB_ENGINE empty to fall back to SQLite
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kpitb_hackathon
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ========== CORS ==========
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== Frontend ==========
FRONTEND_URL=http://localhost:5173

# Email: console backend for local development; use SMTP in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Production security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ========== Azure Blob Storage (Phase 2+) ==========
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=
AZURE_BLOB_ENDPOINT=
